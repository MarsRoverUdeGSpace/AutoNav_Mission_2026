<?xml version="1.0"?>
<sdf version="1.10">
  <model name="random_world">
    <static>true</static>

    <link name="link">
      <!-- Collision heightmap -->
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://random_world/media/materials/texture/random_world.png</uri>
            <size>20 20 2</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>

      <!-- Visual heightmap (no textures, let Gazebo pick defaults) -->
      <visual name="visual">
        <geometry>
          <heightmap>
            <uri>model://random_world/media/materials/texture/random_world.png</uri>
            <size>20 20 2</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>

