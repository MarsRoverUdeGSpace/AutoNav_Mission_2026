<?xml version="1.0"?>
<sdf version="1.10">
  <world name="random_heightmap_world">
    <!-- Core Gazebo systems. UserCommands provides /world/<name>/create for ros_gz_sim create;
         SceneBroadcaster populates the GUI; Physics drives the simulation. -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <!-- Georeference the world for Gazebo NavSat. ENU matches robot_localization/navsat_transform. -->
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>19.432608</latitude_deg>
      <longitude_deg>-99.133209</longitude_deg>
      <elevation>2240.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.2 0.2 0.2 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gravity>0 0 -9.8</gravity>
    <physics name="ode" default="true" type="ode">
      <max_step_size>0.05</max_step_size>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <include>
      <uri>model://random_world</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
