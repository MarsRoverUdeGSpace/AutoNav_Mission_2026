<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Nav2 GPS tutorial world georeference.
       Sonoma Raceway is a real place, so Gazebo NavSat readings can be sanity-checked
       against a meaningful WGS84 location instead of our arbitrary random heightmap. -->
  <world name="sonoma_raceway_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Keep this world lightweight: Maya's current sim publishes wheel odom, IMU,
         lidar, and GNSS without a world-level Sensors render thread. Loading the
         Sonoma Fuel visual model plus Sensors can crash gz-sim with duplicate OGRE
         scene/material names on Jazzy. -->
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>38.161479</latitude_deg>
      <longitude_deg>-122.454630</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.2 0.2 0.2 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gravity>0 0 -9.8</gravity>
    <physics name="ode" default="true" type="ode">
      <!-- Faster than the tutorial Turtlebot world; Maya/Nav2 validation needs
           reasonable wall-clock topic rates more than 3 ms physics fidelity. -->
      <max_step_size>0.02</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Keep a simple collision plane under the robot. The visual Sonoma model is
         shifted like the official Nav2 GPS tutorial world. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sonoma Raceway</uri>
      <name>sonoma_raceway</name>
      <pose>-287.5 143.5 -7 0 0 0</pose>
    </include>
  </world>
</sdf>
