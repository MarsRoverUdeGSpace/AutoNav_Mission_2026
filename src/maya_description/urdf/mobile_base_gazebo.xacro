<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- brief Gazebo plugins for skid steer drive and joint state bridge -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Match Gazebo wheel groups to the actual rover left/right sides.
           Swapping these corrupts turn kinematics and poisons /odom yaw. -->
      <left_joint>front_left_joint</left_joint>
      <left_joint>back_left_joint</left_joint>

      <right_joint>front_right_joint</right_joint>
      <right_joint>back_right_joint</right_joint>

      <!-- Frames consistent with ROS navigation stack -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_topic>/model/maya/odometry</odom_topic>
      <tf_topic>/model/maya/tf</tf_topic>

      <!-- Drive parameters pulled from common properties -->
      <wheel_separation>${drive_wheel_separation}</wheel_separation>
      <wheel_radius>${drive_wheel_radius}</wheel_radius>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- Give the drive wheels explicit contact parameters for skid-steer turning.
       Heightmap terrain is much less forgiving than the empty world defaults. -->
  <gazebo reference="front_left">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <slip1>0.02</slip1>
    <slip2>0.02</slip2>
  </gazebo>

  <gazebo reference="back_left">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <slip1>0.02</slip1>
    <slip2>0.02</slip2>
  </gazebo>

  <gazebo reference="front_right">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <slip1>0.02</slip1>
    <slip2>0.02</slip2>
  </gazebo>

  <gazebo reference="back_right">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <slip1>0.02</slip1>
    <slip2>0.02</slip2>
  </gazebo>



  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

</robot>
